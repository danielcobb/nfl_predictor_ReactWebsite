# Virtual envs - image does a clean `pip install -r requirements.txt` instead
# of copying the venv EC2 uses at backend/.venv.
.venv/
venv/
backend/.venv/

# Python
**/__pycache__/
*.py[cod]
*.egg-info/

# Version control / editor / OS cruft
.git/
.gitignore
.vscode/
**/.DS_Store

# Legacy SQLite database - predictions now live in Postgres (see backend/db.py).
# Excluded so it doesn't get baked into the image; kept in the repo only as the
# source for the one-time migration (backend/migrate_to_postgres.py).
backend/predictions.db
backend/predictions.db-wal
backend/predictions.db-shm

# Unrelated parts of this repo the backend image doesn't need.
nfl-predictor-react-app/
python_files/
PROJECT_OVERVIEW.md
README.md
