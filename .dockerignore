# Virtual envs - image does a clean `pip install -r requirements.txt` instead
# of copying the venv EC2 uses at backend/.venv.
.venv/
venv/
backend/.venv/

# Python
**/__pycache__/
*.py[cod]
*.egg-info/

# Version control / editor / OS cruft
.git/
.gitignore
.vscode/
**/.DS_Store

# SQLite database - deliberately NOT baked into the image; supplied via a
# bind-mounted volume in docker-compose.yml instead so a rebuild never
# resets real prediction data. (-wal/-shm are WAL-mode side files that
# appear next to it at runtime - see backend/main.py's ensure_db().)
backend/predictions.db
backend/predictions.db-wal
backend/predictions.db-shm

# Unrelated parts of this repo the backend image doesn't need.
nfl-predictor-react-app/
python_files/
PROJECT_OVERVIEW.md
README.md
